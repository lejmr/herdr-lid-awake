#!/bin/bash
# Keep the Mac running with the lid closed while the Herdr cup is on.
# Watches power assertions live; when Herdr holds PreventUserIdleSystemSleep,
# sets `pmset disablesleep 1`, and clears it once Herdr lets go.
# Needs a sudoers rule for pmset: run `herdr-lid-awake install-sudoers` once.

VERSION=0.2.0

# The env overrides exist for tests/run.sh; the defaults are production.
PMSET=${HERDR_LID_AWAKE_PMSET:-/usr/bin/pmset}
SUDO=${HERDR_LID_AWAKE_SUDO:-sudo}
VISUDO=${HERDR_LID_AWAKE_VISUDO:-/usr/sbin/visudo}
IOREG=${HERDR_LID_AWAKE_IOREG:-/usr/sbin/ioreg}
STATE=${HERDR_LID_AWAKE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-lid-awake}
# Exists exactly while this tool has sleep disabled, so a kill -9 or a power
# loss is recognised on the next start.
MARKER=$STATE/holding

# Under `sudo herdr-lid-awake ...` id says root; the rule is for the user who ran sudo.
# Sets $user and $uid. The file is named by uid: sudo skips files in sudoers.d whose
# name contains a '.', and user names may (jana.novak). One file per user, so a
# second account does not overwrite the first one's rule.
who() {
  user=$(id -un) uid=$(id -u)
  [ "$uid" = 0 ] && { user=${SUDO_USER:-}; uid=${SUDO_UID:-}; }
  case $user:$uid in
    :*|*:|root:*|*:0) echo "run as your own user, not root (a rule for root is useless)" >&2; return 1 ;;
  esac
}
# A function, not `"$0" sudoers`: run as `bash herdr-lid-awake`, $0 has no slash and
# would resolve through PATH to some other install.
rule() { who && echo "$user ALL=(root) NOPASSWD: /usr/bin/pmset disablesleep 0, /usr/bin/pmset disablesleep 1"; }

sleep_disabled() { "$PMSET" -g | grep -q 'SleepDisabled[[:space:]]*1'; }
# Does the rule really work? Run it, writing back the current value, which changes nothing.
# Not `sudo -l`: for an admin `(ALL) ALL` lists every command, password or not.
# -k: the password just typed for `sudo install` is cached and would pass without the rule.
# ponytail: a watcher flipping SleepDisabled between the read and the write is undone; only
# install-sudoers with a running watcher and a cup change in that instant could hit it.
rule_works() {
  local v=0 as=()
  sleep_disabled && v=1
  # Under `sudo herdr-lid-awake install-sudoers` this runs as root, who needs no rule: ask as the user.
  [ "$(id -u)" = 0 ] && [ -n "${user:-}" ] && as=("$SUDO" -u "$user")
  "${as[@]}" "$SUDO" -k -n "$PMSET" disablesleep $v >/dev/null 2>&1
}

case $1 in
  --version)
    echo "herdr-lid-awake $VERSION"
    exit ;;
  sudoers)
    rule
    exit ;;
  install-sudoers)
    # A broken file in sudoers.d disables sudo entirely, so validate before installing.
    tmp=$(mktemp) && rule > "$tmp" && "$VISUDO" -cqf "$tmp" &&
      "$SUDO" install -m 0440 -o root -g wheel "$tmp" "/etc/sudoers.d/herdr-lid-awake-$uid" &&
      echo "installed /etc/sudoers.d/herdr-lid-awake-$uid"
    rc=$?
    # An installed file is not an effective one: /etc/sudoers may lack #includedir.
    if [ $rc = 0 ] && ! rule_works; then
      echo "but sudo does not use it: does /etc/sudoers have '#includedir /etc/sudoers.d'?" >&2; rc=1
    fi
    rm -f "$tmp"; exit $rc ;;
  -h|--help)
    echo "usage: herdr-lid-awake [--version | sudoers | install-sudoers]"
    exit ;;
  "") ;;
  *)
    echo "usage: herdr-lid-awake [--version | sudoers | install-sudoers]" >&2
    exit 2 ;;
esac

owned=0
warned=0

# keep_awake_scope "system" may hold PreventSystemSleep instead (unverified); (Herdr) stays exact.
cup_on() { "$PMSET" -g assertions | grep -Eq '\(Herdr\).*Prevent(UserIdle)?SystemSleep'; }
log() { echo "$(date '+%F %T') lid: $1"; }

# macOS sleeps on the lid-close event. If the lid closed while sleep was disabled, that
# event is gone and the Mac would stay awake until the lid is opened and closed again
# (the cup "until agents finish" turns off exactly then). So sleep now, unless the lid is
# open or CausesSleep says No: an external display keeps a closed Mac in use.
# Polled briefly in case CausesSleep follows disablesleep 0 with a delay (unverified).
sleep_if_lid_closed() {
  local s
  for _ in 1 2 3 4; do
    s=$("$IOREG" -r -k AppleClamshellState -d 1)
    [[ $s == *'"AppleClamshellState" = Yes'* ]] || return 0
    if [[ $s == *'"AppleClamshellCausesSleep" = Yes'* ]]; then
      log "lid closed, sleeping now"; "$PMSET" sleepnow >/dev/null; return 0
    fi
    sleep 0.5
  done
}

# Say it once, not once per event.
warn() {
  [ $warned = 1 ] && return
  warned=1
  echo "sudoers rule missing: run herdr-lid-awake install-sudoers" >&2
}

run_sudo() { "$SUDO" -n "$PMSET" "$@" 2>/dev/null || { warn; return 1; }; }

apply() {
  if cup_on; then
    # Leave a SleepDisabled 1 someone else set alone; only clear what we set.
    if [ $owned = 0 ] && ! sleep_disabled; then
      # No marker, no disablesleep: a kill -9 would leave sleep off for good.
      if mkdir -p "$STATE" 2>/dev/null && : > "$MARKER"; then
        if run_sudo disablesleep 1; then owned=1; log awake; else rm -f "$MARKER"; fi
      else
        echo "cannot write $MARKER, not disabling sleep" >&2
      fi
    fi
  elif [ $owned = 1 ]; then
    run_sudo disablesleep 0 && owned=0 && rm -f "$MARKER" && log sleeps && sleep_if_lid_closed
  fi
}

release() {
  trap - EXIT INT TERM HUP
  rm -f "$PIDFILE"
  [ $owned = 1 ] && run_sudo disablesleep 0 && rm -f "$MARKER"
  # ponytail: kills every child of this shell; fine while `script` is the only one.
  pkill -P $$ 2>/dev/null
  exit 0
}
# One watcher at a time: a second would adopt the first one's marker and clear sleep too early.
# ponytail: pid file, racy if two start in the same millisecond; lockf(1) if that ever happens.
PIDFILE=$STATE/pid
if p=$(cat "$PIDFILE" 2>/dev/null) && ps -p "$p" -o command= 2>/dev/null | grep -q herdr-lid-awake; then
  echo "herdr-lid-awake already running (pid $p)" >&2
  exit 1
fi
mkdir -p "$STATE" 2>/dev/null && echo $$ > "$PIDFILE"

trap release EXIT INT TERM HUP

rule_works || warn

# A marker means a previous run died holding SleepDisabled 1: take it over.
# Cup still on, we keep holding; cup gone, apply lets go.
# If sleep is not disabled any more (reboot, someone cleared it), the marker is stale.
if [ -e "$MARKER" ]; then
  if sleep_disabled; then owned=1; else rm -f "$MARKER"; fi
fi

apply
# `script` gives pmset a pty, otherwise it block-buffers and lines arrive late.
# Any Herdr line (Created, Released, ClientDied) triggers a re-check, and so
# does the first line, which closes the gap between the check above and the stream.
first=1
while IFS= read -r line; do
  if [ $first = 1 ]; then first=0; apply; fi
  case $line in *Herdr*) apply ;; esac
done < <(exec script -q /dev/null "$PMSET" -g assertionslog </dev/null)
